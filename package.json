{
  "name": "ronlens-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RONLENS fictional demo foundation and reference-based home preview",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "test:browser": "playwright test",
    "dev": "python3 -m http.server 4183 --bind 127.0.0.1 --directory site"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "typescript": "5.9.3"
  }
}
